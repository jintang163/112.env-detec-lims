{
  "name": "LIMS环境检测移动作业端",
  "appid": "",
  "description": "委托采样移动作业: 任务、采样打点(BD-09)、离线缓存",
  "versionName": "1.0.0",
  "versionCode": "100",
  "transformPx": false,
  "app-plus": {
    "usingComponents": true,
    "nvueStyleCompiler": "uni-app",
    "compilerVersion": 3,
    "splashscreen": { "alwaysShowBeforeRender": true, "waiting": true, "autoclose": true, "delay": 0 },
    "modules": {
      "Maps": {},
      "SQLite": {}
    },
    "distribute": {
      "android": {
        "permissions": [
          "<uses-permission android:name=\"android.permission.ACCESS_FINE_LOCATION\"/>",
          "<uses-permission android:name=\"android.permission.ACCESS_COARSE_LOCATION\"/>",
          "<uses-permission android:name=\"android.permission.WRITE_EXTERNAL_STORAGE\"/>"
        ],
        "abiFilters": ["armeabi-v7a", "arm64-v8a"],
        "maps": {
          "baidu": {
            "appkey_ios": "",
            "appkey_android": "您的百度地图SDK AK(Android)"
          }
        }
      },
      "ios": {},
      "sdkConfigs": {
        "maps": { "baidu": { "appkey_ios": "", "appkey_android": "" } }
      }
    }
  },
  "quickapp": {},
  "mp-weixin": {
    "appid": "",
    "setting": { "urlCheck": false },
    "usingComponents": true,
    "permission": {
      "scope.userLocation": { "desc": "用于采样点位记录" }
    }
  },
  "h5": {
    "router": { "mode": "hash" },
    "devServer": {
      "https": false
    }
  },
  "vueVersion": "3"
}
